DOCRELEASE=@RELEASE@

DGDIR?=/usr/share/pmg-doc-generator

ASCIIDOC_PMG?=/usr/bin/asciidoc-pmg

PERL_DOC_ENV=PMG_GENERATING_DOCS=1

PMG_COMMON_DOC_SOURCES=                 \
	${ASCIIDOC_PMG}			\
	pmg-copyright.adoc              \
	docinfo.xml

all:

generated/pmgsh.1-synopsis.adoc:
	@mkdir -p generated
	@echo 'Interactive session:' >$@.tmp
	@echo '' >>$@.tmp
	@echo '*pmgsh*' >>$@.tmp
	@echo '' >>$@.tmp
	@echo 'Directly call API functions:' >>$@.tmp
	@echo '' >>$@.tmp
	@echo '*pmgsh* `(get|set|create|help)` `<path>` `[OPTIONS]`' >>$@.tmp
	mv $@.tmp $@

generated/pmg-smtp-filter.8-synopsis.adoc:
	@mkdir -p generated
	@echo 'Please use systemd tools to manage this service.' >$@.tmp
	@echo '' >>$@.tmp
	@echo '*systemctl* `(start|stop|restart|reload|status)` `pmg-smtp-filter`' >>$@.tmp
	mv $@.tmp $@

generated/pmgpolicy.8-synopsis.adoc:
	@mkdir -p generated
	@echo 'Please use systemd tools to manage this service.' >$@.tmp
	@echo '' >>$@.tmp
	@echo '*systemctl* `(start|stop|restart|reload|status)` `pmgpolicy`' >>$@.tmp
	mv $@.tmp $@

docinfo.xml:
	cp ${DGDIR}/$@ $@.tmp
	mv $@.tmp $@

generated/%-opts.adoc: ${DGDIR}/gen-%-opts.pl
	@mkdir -p generated
	$(PERL_DOC_ENV) perl -I. ${DGDIR}/gen-$*-opts.pl >$@.tmp
	mv $@.tmp $@

generated/pmg.%-conf-opts.adoc: ${DGDIR}/gen-pmg.conf.5-opts.pl
	@mkdir -p generated
	$(PERL_DOC_ENV) perl -I. ${DGDIR}/gen-pmg.conf.5-opts.pl $* >$@.tmp
	mv $@.tmp $@

generated/%.adoc: ${DGDIR}/gen-%-adoc.pl
	@mkdir -p generated
	$(PERL_DOC_ENV) perl -I. ${DGDIR}/gen-$*-adoc.pl >$@.tmp
	mv $@.tmp $@

generated/%.1-synopsis.adoc:
	@mkdir -p generated
	$(PERL_DOC_ENV) perl -I. -e "use PMG::CLI::$(subst -,_,$*);print PMG::CLI::$(subst -,_,$*)->generate_asciidoc_synopsis();" > $@.tmp
	mv $@.tmp $@

generated/%.8-synopsis.adoc:
	@mkdir -p generated
	$(PERL_DOC_ENV) perl -I. -e "use PMG::Service::$(subst -,_,$*);print PMG::Service::$(subst -,_,$*)->generate_asciidoc_synopsis();" > $@.tmp
	mv $@.tmp $@

ifneq (${DGDIR},.)
%.adoc: ${DGDIR}/%.adoc
	cp $< $@.tmp
	mv $@.tmp $@
endif


%-plain.html: %.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-wiki -o $@ $*.adoc

chapter-%.html: %.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-chapter -o $@ $*.adoc

%.1: %.adoc generated/%.1-synopsis.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-man -o $@ $*.adoc

%.1.html: %.adoc generated/%.1-synopsis.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-man-html -o $@ $*.adoc

%.8: %.adoc generated/%.8-synopsis.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-man -o $@ $*.adoc

%.8.html: %.adoc generated/%.8-synopsis.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-man-html -o $@ $*.adoc

%.5: %.adoc generated/%.5-opts.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-man -o $@ $*.adoc

%.5.html: %.adoc generated/%.5-opts.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-man-html -o $@ $*.adoc

%.5-plain.html: %.adoc generated/%.5-opts.adoc ${PMG_COMMON_DOC_SOURCES}
	${ASCIIDOC_PMG} compile-man-wiki -o $@ $*.adoc


.PHONY: cleanup-docgen
cleanup-docgen:
	rm -f *.xml.tmp *.1 *.5 *.8 *.adoc docinfo.xml
	rm -rf generated

